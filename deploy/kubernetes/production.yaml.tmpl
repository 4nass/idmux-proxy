apiVersion: v1
kind: Namespace
metadata:
  name: idmux
  labels:
    pod-security.kubernetes.io/enforce: restricted
    pod-security.kubernetes.io/audit: restricted
    pod-security.kubernetes.io/warn: restricted
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: idmux
  namespace: idmux
  labels:
    app.kubernetes.io/name: idmux
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/name: idmux
  template:
    metadata:
      labels:
        app.kubernetes.io/name: idmux
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: idmux
          image: ghcr.io/4nass/idmux-proxy@${IDMUX_IMAGE_DIGEST}
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 9000
              protocol: TCP
          env:
            - name: IDMUX_ENV
              value: production
            - name: IDMUX_LISTEN_PORT
              value: ":9000"
            - name: IDMUX_UPSTREAM_URL
              value: https://idp.example.com
            - name: IDMUX_COOKIE_NAME
              value: KEYCLOAK_IDENTITY
            - name: IDMUX_SESSION_COOKIE_NAME
              value: IDMUX_SESSION
            - name: IDMUX_ENCRYPTION_KEY_FILE
              value: /var/run/idmux-secrets/key
            - name: IDMUX_COOKIE_SECURE
              value: "true"
            - name: IDMUX_COOKIE_SAMESITE
              value: lax
            - name: IDMUX_SESSION_TTL
              value: 12h
            - name: IDMUX_MAX_SESSIONS
              value: "8"
            - name: IDMUX_MAX_REQUEST_BODY_BYTES
              value: "1048576"
            - name: IDMUX_UPSTREAM_TIMEOUT
              value: 45s
            - name: IDMUX_TRUSTED_ORIGINS
              value: https://app.example.com
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          resources:
            requests:
              cpu: 100m
              memory: 64Mi
            limits:
              cpu: 500m
              memory: 128Mi
          startupProbe:
            httpGet:
              path: /__idmux/healthz
              port: http
            periodSeconds: 2
            failureThreshold: 30
          livenessProbe:
            httpGet:
              path: /__idmux/healthz
              port: http
            periodSeconds: 10
            timeoutSeconds: 2
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /__idmux/readyz
              port: http
            periodSeconds: 5
            timeoutSeconds: 2
            failureThreshold: 3
          volumeMounts:
            - name: idmux-key
              mountPath: /var/run/idmux-secrets
              readOnly: true
      volumes:
        - name: idmux-key
          secret:
            secretName: idmux-session
            defaultMode: 0440
---
apiVersion: v1
kind: Service
metadata:
  name: idmux
  namespace: idmux
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: idmux
  ports:
    - name: http
      port: 9000
      targetPort: http
      protocol: TCP
